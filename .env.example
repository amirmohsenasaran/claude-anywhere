# Shared password for the web app (anyone who knows it can chat as you)
REMOTE_PASSWORD=change-me
# Where to listen. 127.0.0.1 = this PC only (use Tailscale serve / Cloudflare Tunnel to reach it from the phone).
# Set HOST=0.0.0.0 to expose it on your own LAN / Tailscale IP directly.
HOST=127.0.0.1
PORT=7777
# Your name, for the greeting
USER_NAME=Arya

# Optional: run this app on a different Claude account than the one `claude login`
# uses on this PC. Paste a long-lived token from `claude setup-token` (subscription)
# or a Console API key. Leave both empty to use the machine's normal login.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

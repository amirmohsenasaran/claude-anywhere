# Optional app password. Leave empty and the app needs no password at all: anyone who can
# reach the port can then use Claude on this PC, so keep it on localhost, Tailscale, or a
# network you trust. Set one to require it on every device.
REMOTE_PASSWORD=
# Where to listen. 127.0.0.1 = this PC only; 0.0.0.0 = reachable from the phone (LAN / Tailscale).
HOST=127.0.0.1
PORT=7777
# Your name, for the greeting
USER_NAME=you

# The Claude account is chosen inside the app (this computer's login, or a pasted token),
# not here. These are only for running the server on a fixed account from the shell:
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

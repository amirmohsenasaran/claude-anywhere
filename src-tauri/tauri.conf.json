{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Anywhere",
  "version": "0.3.0",
  "identifier": "com.arya.claude-anywhere",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../server.mjs": "server/server.mjs",
      "../package.json": "server/package.json",
      "../lib": "server/lib",
      "../public": "server/public",
      "../node_modules": "server/node_modules"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

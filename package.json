{
  "name": "claude-anywhere",
  "version": "0.3.0",
  "description": "Your Claude Code sessions, on every screen: a self-hosted desktop and web client for the sessions already on your computer.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "agent-sdk",
    "self-hosted",
    "tauri",
    "remote"
  ],
  "homepage": "https://github.com/aryasadeghy/claude-anywhere#readme",
  "bugs": "https://github.com/aryasadeghy/claude-anywhere/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryasadeghy/claude-anywhere.git"
  },
  "license": "MIT",
  "author": "Arya Sadeghi",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "desktop": "cargo tauri dev",
    "dist": "cargo tauri build",
    "release": "node scripts/release.mjs",
    "check": "node --check server.mjs && node --check lib/runs.mjs && node --check lib/tail.mjs && node --check lib/auth.mjs && node --check public/app.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.274",
    "dompurify": "^3.4.15",
    "express": "^5.2.1",
    "marked": "^18.0.13",
    "zod": "^4.6.5"
  }
}
